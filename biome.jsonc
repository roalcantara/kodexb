{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc",
      "!dist",
      "!build",
      "!node_modules",
      "!assets",
      "!.github",
      "!.claude",
      "!.cursor",
      "!.opencode",
      "!.agents",
      "!.code-review-graph",
      "!bdd/e2e/.generated",
      "!tmp",
      "!packages/ops/src/graphify-out",
      "!.venv",
      "!.worktrees",
      "!.opencode"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "formatWithErrors": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noAlert": "error",
        "noConstantBinaryExpressions": "error",
        "noEmptyBlockStatements": "error",
        "noEmptySource": "error",
        "noEvolvingTypes": "error",
        "noMisplacedAssertion": "error",
        "noUnassignedVariables": "error",
        "noUnusedExpressions": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "noProto": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noMagicNumbers": "error",
        "useConst": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["snake_case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "strictCase": true,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "snake_case", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "const"
                },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "snake_case", "PascalCase"]
              }
            ]
          }
        },
        "noDoneCallback": "error",
        "noNegationElse": "error",
        "noParameterAssign": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentMemberAccessibility": "error",
        "useGroupedAccessorPairs": "error",
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": {
          "level": "error",
          "options": {
            "ignoreDifferentlyNamedParameters": true
          }
        },
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": "error",
        "useConsistentMethodSignatures": "error",
        "useErrorCause": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "useArrowFunction": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 50,
            "skipBlankLines": true
          }
        },
        "noUselessCatchBinding": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "noVoid": "error",
        "noRedundantDefaultExport": "error",
        "noUselessReturn": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useImportExtensions": {
          "level": "off",
          "options": {
            "forceJsExtensions": false
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpect": "error",
        "useImportsFirst": "error"
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noBarrelFile": "off",
        "noDelete": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "off",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noSecrets": "error"
      }
    },
    "domains": {
      "project": "recommended",
      "test": "recommended"
    }
  },
  "javascript": {
    "globals": ["$", "_"],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded"
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "trailingCommas": "none",
      "expand": "auto",
      "trailingNewline": true
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["src/__tests__/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          },
          "nursery": {},
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.e2e.spec.ts",
        "**/*.test.tsx",
        "**/*.spec.tsx",
        "**/__tests__/**/*.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 200,
                "skipBlankLines": true
              }
            }
          },
          "style": {
            "noMagicNumbers": "off",
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 1000,
                "skipBlankLines": true
              }
            }
          },
          "security": {
            "noSecrets": "off"
          },
          "nursery": {}
        }
      }
    },
    {
      "includes": ["packages/**/*.script.ts", "packages/**/*.schema.ts"],
      "linter": {
        "rules": {
          "nursery": {},
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 600,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ops/src/governance/registries/skill/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useNamingConvention": "off",
            "noExcessiveLinesPerFile": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "nursery": {}
        }
      }
    },
    {
      "includes": ["packages/ops/src/**/*.script.ts", "packages/dev/src/**/*.script.ts", "bin/**/*.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useNamingConvention": "off",
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": {
                "maxLines": 400,
                "skipBlankLines": true
              }
            }
          },
          "security": {
            "noSecrets": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "nursery": {}
        }
      }
    },
    {
      "includes": ["packages/ops/src/governance/registries/skill/**/*.script.ts"],
      "linter": {
        "rules": {
          "nursery": {},
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["bdd/e2e/**/*.ts", "bdd/e2e/**/*.tsx", "bdd/unit/**/*.ts", "bdd/unit/**/*.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off",
            "useAwait": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "noDefaultExport": "off",
            "useConsistentMemberAccessibility": "off",
            "useConsistentTypeDefinitions": "off",
            "noExcessiveClassesPerFile": "off",
            "useConsistentMethodSignatures": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedPrivateClassMembers": "off"
          },
          "nursery": {
            "useImportsFirst": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["electrobun.config.ts", "playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/shell/app/app.ts"],
      "linter": {
        "rules": {
          "nursery": {},
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 320,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shell/renderer/**/*.tsx", "src/shell/renderer/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
