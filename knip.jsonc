{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/shell/main/index.ts",
    "src/shell/renderer/index.ts",
    "src/core/index.ts",
    "src/shared/types/index.ts",
    "src/shared/utils/index.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "e2e/support/fixtures.support.ts",
    "e2e/steps/**/*.ts",
    "e2e/support/preview_with_fixture.support.ts",
    "tools/metrics/harnesses/e2e-quality/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "src/shell/renderer/**/*.tsx",
    "e2e/**/*.ts",
    "tools/metrics/harnesses/e2e-quality/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/three", "tailwindcss", "@tailwindcss/cli"],
  "ignoreBinaries": ["mise"]
}
