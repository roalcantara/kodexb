{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/shell/main/index.ts",
    "src/shell/renderer/index.ts",
    "src/core/index.ts",
    "src/shared/types/index.ts",
    "src/shared/utils/index.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "e2e/**/*.e2e.spec.ts"
  ],
  "project": ["src/**/*.ts", "src/shell/renderer/**/*.tsx", "e2e/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@types/three"],
  "ignoreBinaries": ["mise"]
}
