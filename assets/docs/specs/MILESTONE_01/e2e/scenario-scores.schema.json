{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb.local/schemas/e2e-scenario-scores.schema.json",
  "title": "E2e scenario quality scores",
  "description": "Sidecar for human review scores and automated flags per scenario. Run metrics merge this file with Playwright/bddgen output.",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewedBy": {
      "type": "string",
      "description": "Maintainer or agent id that last reviewed scores."
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenarioScore"
      }
    }
  },
  "$defs": {
    "scoreBreakdown": {
      "type": "object",
      "required": [
        "businessPriorityCoverage",
        "scenarioQuality",
        "assertionStrength",
        "determinism",
        "screenplayStructure",
        "maintainability",
        "diagnostics"
      ],
      "properties": {
        "businessPriorityCoverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "scenarioQuality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "assertionStrength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "determinism": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "screenplayStructure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "maintainability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "scenarioScore": {
      "type": "object",
      "required": [
        "id",
        "feature",
        "priority",
        "status",
        "qualityScore"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id from step-catalog.md scenario ID table.",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "feature": {
          "type": "string",
          "description": "Path to feature file.",
          "pattern": "^assets/features/e2e/.+\\.feature$"
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "implemented",
            "deferred_native",
            "unit_only"
          ]
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SDD slugs from @spec: tags without prefix."
        },
        "qualityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "scoreBreakdown": {
          "$ref": "#/$defs/scoreBreakdown"
        },
        "weakAssertions": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of Then steps flagged weak in step-catalog."
        },
        "conditionalSkips": {
          "type": "integer",
          "minimum": 0
        },
        "knownFlakes": {
          "type": "integer",
          "minimum": 0
        },
        "reviewNotes": {
          "type": "string"
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
