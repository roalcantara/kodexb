{
  "name": "kb",
  "version": "0.9.0",
  "description": "Native desktop knowledge management app built on Electrobun",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electrobun dev",
    "predev": "mise run -q app styles",
    "dev": "electrobun dev --watch",
    "prebuild": "mise run -q app styles",
    "prebuild:prod": "mise run -q app styles",
    "dev:cef": "ELECTROBUN_RENDERER=cef bun run dev",
    "dev:verbose": "LOG_LEVEL=verbose bun run dev",
    "dev:debug": "LOG_LEVEL=debug bun run dev",
    "dev:trace": "LOG_LEVEL=trace bun run dev",
    "dev:kill": "mise run app --kill",
    "build": "electrobun build",
    "build:ci": "electrobun build",
    "build:prod": "electrobun build --env=stable",
    "styles:compile": "bash tools/scripts/compile_renderer_styles.sh",
    "build:insecure-local": "NODE_TLS_REJECT_UNAUTHORIZED=0 electrobun build",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bunx tsc --noEmit",
    "lint": "mise run lint check",
    "lint:strict": "mise run lint check",
    "lint:fix": "mise run lint fix",
    "lint:biome": "bunx biome check",
    "lint:biome:strict": "bunx biome check --diagnostic-level=warn --error-on-warnings",
    "lint:biome:fix": "bunx biome check --write --diagnostic-level=warn --error-on-warnings",
    "lint:biome:format": "bunx biome format",
    "lint:mise": "mise exec -- tombi check mise.toml",
    "lint:knip": "bunx knip --no-exit-code",
    "lint:depcruise": "bunx depcruise . --config .dependency-cruiser.cjs",
    "lint:jscpd": "bunx jscpd . --noTips --reporters console",
    "lint:ls": "bunx @ls-lint/ls-lint",
    "lint:hadolint": "mise exec -- hadolint Dockerfile",
    "lint:renderer-css": "bash tools/scripts/check_renderer_css_tokens.sh",
    "lint:spec-guide": "bash tools/scripts/check_spec_testing_guide.sh",
    "lint:ast-grep": "mise exec -- ast-grep scan src tools --report-style=rich --error",
    "lint:ast-grep:fix": "mise exec -- ast-grep scan src tools --update-all",
    "e2e:preview:install": "bunx playwright install chromium",
    "e2e:bddgen": "bunx bddgen test",
    "e2e": "bun run e2e:bddgen && bunx playwright test",
    "e2e:ui": "bun run e2e:bddgen && bunx playwright test --ui",
    "e2e:smoke": "bun run e2e:bddgen && bunx playwright test --grep @smoke",
    "e2e:regression": "bun run e2e:bddgen && bunx playwright test --grep @regression",
    "e2e:metrics-report": "bun tools/e2e/e2e_metrics.script.ts report",
    "e2e:metrics-compare": "bun tools/e2e/e2e_metrics.script.ts compare",
    "e2e:write-baseline": "bun tools/e2e/e2e_metrics.script.ts write-baseline",
    "e2e:preview": "bunx playwright test e2e/preview_list_nav.e2e.spec.ts",
    "e2e:preview:ui": "bunx playwright test e2e/preview_list_nav.e2e.spec.ts --ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.60.0",
    "@release-it/conventional-changelog": "^9",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "dependency-cruiser": "^17.4.2",
    "jscpd": "^4.2.4",
    "knip": "^6.14.2",
    "playwright-bdd": "^8.5.1",
    "release-it": "^20.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@logtape/logtape": "^2.1.1",
    "@logtape/pretty": "^2.1.1",
    "@sinclair/typebox": "^0.34.49",
    "electrobun": "^1.18.1",
    "elysia": "^1.4.28",
    "fast-glob": "^3.3.3",
    "fishery": "^2.4.0",
    "neverthrow": "^8.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "type-fest": "^5.6.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore(release): Release v${version} [skip ci]\n\nPrepare the release commit so changelog and version stay aligned.",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "requireCommits": true
    },
    "github": {
      "release": false,
      "tokenRef": "GH_TOKEN"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": "bun run typecheck"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits"
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n"
      }
    }
  }
}
