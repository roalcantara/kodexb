{
  "name": "kb",
  "version": "0.15.14",
  "description": "Native desktop knowledge management app built on Electrobun",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@logtape/logtape": "^2.1.5",
      "@sinclair/typebox": "^0.34.49",
      "neverthrow": "^8.2.0",
      "xstate": "^5.32.0"
    }
  },
  "scripts": {
    "start": "electrobun dev",
    "install:macos": "bun bin/macos_app.script.ts install",
    "uninstall:macos": "bun bin/macos_app.script.ts uninstall",
    "reinstall:macos": "mise run app --kill && bun run uninstall:macos && rm -rf build dist && bun run install:macos",
    "startup:enable": "bun bin/macos_app.script.ts login-item enable",
    "startup:disable": "bun bin/macos_app.script.ts login-item disable",
    "predev": "mise run -q app styles",
    "dev": "electrobun dev --watch",
    "prebuild": "mise run -q app styles",
    "prebuild:prod": "mise run -q app styles",
    "dev:cef": "ELECTROBUN_RENDERER=cef bun run dev",
    "dev:verbose": "LOG_LEVEL=verbose bun run dev",
    "dev:debug": "LOG_LEVEL=debug bun run dev",
    "dev:trace": "LOG_LEVEL=trace bun run dev",
    "dev:kill": "mise run app --kill",
    "build": "electrobun build",
    "build:ci": "electrobun build",
    "build:prod": "electrobun build --env=stable",
    "styles:compile": "bash packages/ops/src/orchestration/scripts/compile_renderer_styles.sh",
    "build:insecure-local": "NODE_TLS_REJECT_UNAUTHORIZED=0 electrobun build",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bunx tsc --noEmit",
    "lint": "mise run lint check",
    "lint:strict": "mise run lint check",
    "lint:fix": "mise run lint fix",
    "lint:biome": "bunx biome check",
    "lint:biome:strict": "bunx biome check --diagnostic-level=warn --error-on-warnings",
    "lint:biome:fix": "bunx biome check --write --diagnostic-level=warn --error-on-warnings",
    "lint:biome:format": "bunx biome format",
    "lint:mise": "mise exec -- tombi check mise.toml",
    "lint:knip": "bunx knip --no-exit-code",
    "lint:depcruise": "bunx depcruise . --config .dependency-cruiser.cjs",
    "lint:jscpd": "bunx jscpd . --noTips --reporters console",
    "lint:ls": "bunx @ls-lint/ls-lint",
    "lint:hadolint": "mise exec -- hadolint Dockerfile",
    "lint:renderer-css": "bash packages/ops/src/orchestration/scripts/check_renderer_css_tokens.sh",
    "lint:spec-guide": "bash packages/ops/src/orchestration/scripts/check_spec_testing_guide.sh",
    "lint:ast-grep": "mise exec -- ast-grep scan src packages --report-style=rich --error",
    "lint:ast-grep:fix": "mise exec -- ast-grep scan src packages --update-all",
    "bdd:e2e:preview:install": "bunx playwright install chromium",
    "bdd:e2e:bddgen": "bunx bddgen test -c playwright.config.ts",
    "bdd:e2e": "bun run bdd:e2e:bddgen && bunx playwright test -c playwright.config.ts",
    "bdd:e2e:ui": "bun run bdd:e2e:bddgen && bunx playwright test -c playwright.config.ts --ui",
    "bdd:e2e:smoke": "bun run bdd:e2e:bddgen && bunx playwright test -c playwright.config.ts --grep @smoke",
    "bdd:e2e:regression": "bun run bdd:e2e:bddgen && bunx playwright test -c playwright.config.ts --grep @regression",
    "bdd:unit": "bun bdd/unit/runner/run_unit_bdd.script.ts",
    "bdd:unit:dry-run": "bun bdd/unit/runner/run_unit_bdd.script.ts --dry-run",
    "bdd:e2e:metrics-report": "bun packages/ops/src/metrics/harnesses/e2e-quality/e2e_metrics.script.ts report",
    "bdd:e2e:metrics-compare": "bun packages/ops/src/metrics/harnesses/e2e-quality/e2e_metrics.script.ts compare",
    "bdd:e2e:write-baseline": "bun packages/ops/src/metrics/harnesses/e2e-quality/e2e_metrics.script.ts write-baseline",
    "bdd:e2e:preview": "bunx playwright test -c playwright.config.ts bdd/e2e/preview_list_nav.e2e.spec.ts",
    "bdd:e2e:preview:ui": "bunx playwright test -c playwright.config.ts bdd/e2e/preview_list_nav.e2e.spec.ts --ui",
    "e2e:preview:install": "bun run bdd:e2e:preview:install",
    "e2e:bddgen": "bun run bdd:e2e:bddgen",
    "e2e": "bun run bdd:e2e",
    "e2e:ui": "bun run bdd:e2e:ui",
    "e2e:smoke": "bun run bdd:e2e:smoke",
    "e2e:regression": "bun run bdd:e2e:regression",
    "e2e:metrics-report": "bun run bdd:e2e:metrics-report",
    "e2e:metrics-compare": "bun run bdd:e2e:metrics-compare",
    "e2e:write-baseline": "bun run bdd:e2e:write-baseline",
    "e2e:preview": "bun run bdd:e2e:preview",
    "e2e:preview:ui": "bun run bdd:e2e:preview:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@cucumber/cucumber": "^13.0.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.60.0",
    "@release-it/conventional-changelog": "^9",
    "@tailwindcss/cli": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "dependency-cruiser": "^17.4.3",
    "jscpd": "^4.2.5",
    "knip": "^6.17.1",
    "playwright-bdd": "^8.5.1",
    "release-it": "^20.2.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@logtape/logtape": "^2.1.5",
    "@logtape/pretty": "^2.1.5",
    "@sinclair/typebox": "^0.34.49",
    "electrobun": "^1.18.1",
    "elysia": "^1.4.29",
    "fast-glob": "^3.3.3",
    "fishery": "^2.4.0",
    "highlight.js": "^11.11.1",
    "neverthrow": "^8.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "type-fest": "^5.7.0",
    "xstate": "^5.32.1"
  },
  "overrides": {
    "ansi-regex": "^5.0.1"
  },
  "release-it": {
    "git": {
      "commitArgs": ["-S"],
      "tagArgs": ["-s"],
      "commitMessage": "ci(release): Bump version to ${version} [skip ci]",
      "tagName": "v${version}",
      "tagAnnotation": "Release v${version}",
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "push": true
    },
    "github": {
      "release": true,
      "draft": true,
      "releaseName": "v${version}",
      "tokenRef": "GH_TOKEN"
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "ref",
              "section": "Refactoring"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "test",
              "section": "Tests",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "Chores",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "CI",
              "hidden": true
            }
          ]
        },
        "infile": "CHANGELOG.md",
        "header": "# Changelog"
      }
    }
  }
}
