{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@kb/shared": ["../shared/src/index.ts"],
      "@kb/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
