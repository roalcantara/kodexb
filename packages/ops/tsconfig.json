{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@kb/flow": ["../flow/src/index.ts"],
      "@kb/flow/*": ["../flow/src/*"],
      "@kb/exec": ["../exec/src/index.ts"],
      "@kb/exec/*": ["../exec/src/*"],
      "@kb/ops": ["./src/index.ts"],
      "@kb/ops/*": ["./src/*"],
      "@kb/shared": ["../shared/src/index.ts"],
      "@kb/shared/*": ["../shared/src/*"],
      "@shared/logging": ["../../src/shared/logging/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
